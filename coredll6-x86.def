; ------------------------------------------------------------------
; x86-only COREDLL exports (i386-pc-wince).  Derived from the same
; authoritative CE 6.0 shared source as the ARM def above
; (PRIVATE/WINCEOS/COREOS/CORE/DLL/core_common.def + CRT/corelib1.def),
; re-evaluated with the x86-retail preprocessor context
; (COREDLL_DEF, _X86_, x86, UNDER_CE, _WIN32, _WIN32_WCE) instead of
; the ARM one (_ARM_, ARM).
; ------------------------------------------------------------------
; x86 structured exception handling (coredll provides the SEH runtime;
;  _except_handler3 is what clang/MSVC emit as the __try/__except
;  personality, __abnormal_termination backs __abnormal_termination(),
;  _local_unwind2/4 run the __finally handlers, _SEH_prolog/_SEH_epilog
;  and _EH_prolog/_EH_prolog2 are the frame setup/teardown helpers)
_EH_prolog
_EH_prolog2
_SEH_epilog
_SEH_prolog
__abnormal_termination
_except_handler3
_except_handler4_common
_local_unwind2
_local_unwind4
_setjmp3

; x86 C++ exception handling (single-underscore spelling, unlike ARM's
;  __CxxThrowException)
_CxxThrowException

; x86 64-bit integer helper calls (no native 64-bit arithmetic on i386)
_alldiv
_alldvrm
_allmul
_allrem
_allshl
_allshr
_aulldiv
_aulldvrm
_aullrem
_aullshr

; x86 stack probe (emitted for frames larger than a page)
_alloca_probe
_alloca_probe_16
_alloca_probe_8
_chkstk

; x86 floating-point conversion helpers (the x87/SSE equivalents of the
;  ARM FPCRT-forwarded surface)
_fload
_ftol
_ftol2
_ftol2_sse
_ftol2_sse_excpt

; x86 _CI* intrinsic floating-point calls (x87 argument-checking entry
;  points emitted by the compiler for <math.h> intrinsics)
_CIacos
_CIasin
_CIatan
_CIatan2
_CIcos
_CIcosh
_CIexp
_CIfmod
_CIlog
_CIlog10
_CIpow
_CIsin
_CIsinh
_CIsqrt
_CItan
_CItanh

; x86 port I/O intrinsics
_inp
_inpd
_inpw
_outp
_outpd
_outpw

; x86-only misc (the x87 numeric-processor exception handler hook)
NPXNPHandler


