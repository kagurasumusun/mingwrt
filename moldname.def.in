j1
jn
y0
y1
yn
chgsign
; omit scalb...
; it would conflict with the GCC built-in, which exhibits
; semantics differing from the MSVCRT implementation.
;scalb
finite
fpclass
; C99 functions
cabs
hypot
logb
nextafter
