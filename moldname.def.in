;
; __FILENAME__
;
; Exports from the runtime except that these exports are actually preceeded
; by a underscore in the actual DLL. These correspond to functions which
; are non-ANSI and were prefixed with an underscore to avoid name space
; clutter. However many, in fact most programs still use a few of these
; functions without the underscore. This .def file is specially processed
; to make those non-underscored name function calls call the equivalent
; underscored functions.
;
; Contributors:
;  Created by Colin Peters <colin@bird.fu.is.saga-u.ac.jp>
;  Maintained by Mumit Khan <khan@xraylith.wisc.edu>
;
;  THIS SOFTWARE IS NOT COPYRIGHTED
;
;  This source code is offered for use in the public domain. You may
;  use, modify or distribute it freely.
;
;  This code is distributed in the hope that it will be useful but
;  WITHOUT ANY WARRANTY. ALL WARRENTIES, EXPRESS OR IMPLIED ARE HEREBY
;  DISCLAMED. This includes but is not limited to warrenties of
;  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
;
EXPORTS
#ifdef __COREDLL__
; COREDLL exports the old names with a leading underscore (the device has
; _X but not X).  dlltool's rename syntax "X == _X" binds the plain-name
; call to the device export _X, so the import descriptor names a symbol
; the device actually exports.  A bare entry (plain X) fails at load time
; on the device: "could not resolve import X" -- that is how the first
; VM run of the Stage 5 exe failed, and a plain "X=_X" is no better
; because llvm-dlltool drops the "=" target when writing import
; libraries (verified against the CI libceoldname.a).  This covers every
; CE-active plain name below, verified against the device COREDLL export
; table of the SHARP Brain (PW-AJ2/PW-SH6, WinCE 6.0) NK dump.
#define ecvt ecvt == _ecvt
#define fcvt fcvt == _fcvt
#define fileno fileno == _fileno
#define gcvt gcvt == _gcvt
#define itoa itoa == _itoa
#define ltoa ltoa == _ltoa
#define memccpy memccpy == _memccpy
#define memicmp memicmp == _memicmp
#define setmode setmode == _setmode
#define strdup strdup == _strdup
#define stricmp stricmp == _stricmp
#define strlwr strlwr == _strlwr
#define strnicmp strnicmp == _strnicmp
#define strnset strnset == _strnset
#define strrev strrev == _strrev
#define strset strset == _strset
#define strupr strupr == _strupr
#define swab swab == _swab
#define wcsdup wcsdup == _wcsdup
#define wcsicmp wcsicmp == _wcsicmp
#define wcslwr wcslwr == _wcslwr
#define wcsnicmp wcsnicmp == _wcsnicmp
#define wcsnset wcsnset == _wcsnset
#define wcsrev wcsrev == _wcsrev
#define wcsset wcsset == _wcsset
#define wcsupr wcsupr == _wcsupr
#define j0 j0 == _j0
#define j1 j1 == _j1
#define jn jn == _jn
#define y0 y0 == _y0
#define y1 y1 == _y1
#define yn yn == _yn
#define chgsign chgsign == _chgsign
#define finite finite == _finite
#define fpclass fpclass == _fpclass
#define cabs cabs == _cabs
#define hypot hypot == _hypot
#define logb logb == _logb
#define nextafter nextafter == _nextafter
#endif /* __COREDLL__ */
